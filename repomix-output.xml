import json
import os
from pathlib import Path

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware

from .schemas import PredictRequest
from .model_service import load_bundle, predict_one


# --------------------------------------------------
# Application configuration
# --------------------------------------------------

app = FastAPI(
    title="NEWSCHECK API",
    version="1.0.0",
    description=(
        "Academic NLP text-classification prototype; "
        "not an independent fact-checker."
    ),
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        os.getenv("FRONTEND_ORIGIN", "http://localhost:5173")
    ],
    allow_credentials=False,
    allow_methods=["GET", "POST"],
    allow_headers=["Content-Type"],
)


# --------------------------------------------------
# Project paths
# backend/app/main.py -> project root
# --------------------------------------------------

PROJECT_ROOT = Path(__file__).resolve().parents[2]
METRICS_FILE = PROJECT_ROOT / "outputs" / "classical_metrics.json"


# --------------------------------------------------
# Health endpoint
# --------------------------------------------------

@app.get("/health")
def health():
    trained = load_bundle() is not None

    return {
        "status": "ready" if trained else "models_not_trained",
        "models_trained": trained,
    }


# --------------------------------------------------
# Available models
# --------------------------------------------------

@app.get("/models")
def models():
    return {
        "classical": [
            {
                "id": "logistic_regression",
                "name": "Logistic Regression",
            },
            {
                "id": "passive_aggressive",
                "name": "Passive Aggressive",
            },
            {
                "id": "naive_bayes",
                "name": "Multinomial Naive Bayes",
            },
        ],
        "transformer": {
            "available": False,
            "note": (
                "Optional DistilBERT experiment is trained separately."
            ),
        },
    }


# --------------------------------------------------
# News text prediction
# --------------------------------------------------

@app.post("/predict")
def predict(request: PredictRequest):
    try:
        return predict_one(request.text, request.model)

    except RuntimeError as exc:
        raise HTTPException(
            status_code=503,
            detail=str(exc),
        ) from exc

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Prediction failed: {type(exc).__name__}",
        ) from exc


# --------------------------------------------------
# Model evaluation metrics
# --------------------------------------------------

@app.get("/metrics")
def get_metrics():
    """
    Return the saved evaluation metrics generated by
    backend/train_classical.py.
    """

    if not METRICS_FILE.is_file():
        raise HTTPException(
            status_code=404,
            detail=(
                "Evaluation metrics not found. "
                "Train the classical models first."
            ),
        )

    try:
        with METRICS_FILE.open("r", encoding="utf-8") as file:
            metrics = json.load(file)

        if not isinstance(metrics, dict) or not isinstance(
            metrics.get("models"), dict
        ):
            raise ValueError("Unexpected metrics file structure.")

        return metrics

    except (json.JSONDecodeError, ValueError) as exc:
        raise HTTPException(
            status_code=500,
            detail="The evaluation metrics file contains invalid data.",
        ) from exc

    except OSError as exc:
        raise HTTPException(
            status_code=500,
            detail="Could not read the evaluation metrics file.",
        ) from exc
